<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Variante de los temas Android de inicio cuando el sistema tiene modo oscuro activo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- El fondo de inicio permanece hasta que Flutter dibuja el primer frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Mantiene un fondo de ventana compatible con modo oscuro tras iniciar Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
