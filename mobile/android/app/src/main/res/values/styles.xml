<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema visible durante el arranque, antes de que Flutter dibuje su primera pantalla. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Usa el fondo de inicio y Flutter lo reemplaza al renderizar el primer frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema normal de la ventana Android mientras Flutter inicializa y detrás de la UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
